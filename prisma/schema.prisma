model Verification {
  id         String    @id
  identifier String    @db.Text
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum UserType {
  CANDIDAT
  RECRUTEUR
  COLLABORATEUR
}

enum RecruteurType {
  PARTICULIER
  ENTREPRISE
